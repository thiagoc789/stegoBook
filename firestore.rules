rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ───────────── StegoBook (finanzas) ─────────────
    // Sin autenticación: solo se permite el hogar de Stephania y Santiago.
    match /hogares/stephania-santiago/{document=**} {
      allow read, write: if true;
    }

    // ───────────── Reglas existentes de la otra app (no tocar) ─────────────
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /meta/inviteCodes {
      allow read, write: if request.auth != null;
    }

    match /couples/{coupleId} {
      function isMember() {
        return request.auth != null &&
          (resource.data.user1Uid == request.auth.uid ||
           resource.data.user2Uid == request.auth.uid);
      }
      function isMemberOfNew() {
        return request.auth != null &&
          request.resource.data.user1Uid == request.auth.uid;
      }

      allow read: if isMember() ||
        (request.auth != null && resource.data.user2Uid == null);
      allow create: if isMemberOfNew();
      allow update: if request.auth != null &&
        (resource.data.user1Uid == request.auth.uid ||
         resource.data.user2Uid == request.auth.uid ||
         resource.data.user2Uid == null);

      match /dailyAnswers/{date} {
        allow read, write: if request.auth != null &&
          (get(/databases/$(database)/documents/couples/$(coupleId)).data.user1Uid == request.auth.uid ||
           get(/databases/$(database)/documents/couples/$(coupleId)).data.user2Uid == request.auth.uid);
      }
      match /knowledgeRounds/{date} {
        allow read, write: if request.auth != null &&
          (get(/databases/$(database)/documents/couples/$(coupleId)).data.user1Uid == request.auth.uid ||
           get(/databases/$(database)/documents/couples/$(coupleId)).data.user2Uid == request.auth.uid);
      }
      match /notes/{noteId} {
        allow read, write: if request.auth != null &&
          (get(/databases/$(database)/documents/couples/$(coupleId)).data.user1Uid == request.auth.uid ||
           get(/databases/$(database)/documents/couples/$(coupleId)).data.user2Uid == request.auth.uid);
      }
      match /reminders/{reminderId} {
        allow read, write: if request.auth != null &&
          (get(/databases/$(database)/documents/couples/$(coupleId)).data.user1Uid == request.auth.uid ||
           get(/databases/$(database)/documents/couples/$(coupleId)).data.user2Uid == request.auth.uid);
      }
      match /photos/{photoId} {
        allow read, write: if request.auth != null &&
          (get(/databases/$(database)/documents/couples/$(coupleId)).data.user1Uid == request.auth.uid ||
           get(/databases/$(database)/documents/couples/$(coupleId)).data.user2Uid == request.auth.uid);
      }
      match /intimacy/{date} {
        allow read, write: if request.auth != null &&
          (get(/databases/$(database)/documents/couples/$(coupleId)).data.user1Uid == request.auth.uid ||
           get(/databases/$(database)/documents/couples/$(coupleId)).data.user2Uid == request.auth.uid);
      }
    }
  }
}
